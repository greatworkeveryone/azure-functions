{
  "name": "rpcc-api2",
  "version": "1.0.0",
  "description": "RPCC Azure Functions - myBuildings sync and data API",
  "main": "dist/functions/*.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "npx func start",
    "build": "tsc && cp src/openapi.json dist/openapi.json",
    "watch": "tsc -w",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@azure/functions": "4.12.0",
    "@azure/storage-blob": "12.31.0",
    "@sentry/node": "10.66.0",
    "@types/pdfkit": "0.17.6",
    "exceljs": "4.4.0",
    "jose": "5.10.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.18.0",
    "tedious": "18.6.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@typescript-eslint/parser": "8.58.2",
    "azure-functions-core-tools": "4.10.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "ts-jest": "29.4.11"
  }
}
