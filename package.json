{
  "name": "rpcc-api2",
  "version": "1.0.0",
  "description": "RPCC Azure Functions - myBuildings sync and data API",
  "main": "dist/functions/*.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "npx func start",
    "build": "rm -rf dist && tsc && cp src/openapi.json dist/openapi.json",
    "watch": "tsc -w",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check:routes": "node scripts/check-routes.cjs",
    "export-roles": "tsc && node scripts/export-roles.cjs",
    "migrate": "tsc && node scripts/migrate.cjs",
    "seed:procedures": "tsc && node scripts/seed-procedures.cjs"
  },
  "dependencies": {
    "@azure/functions": "4.12.0",
    "@azure/storage-blob": "12.31.0",
    "@sentry/node": "10.66.0",
    "exceljs": "4.4.0",
    "jose": "5.10.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.18.0",
    "tedious": "18.6.2"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0",
    "tmp": "0.2.7",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "brace-expansion@^2.0.0": "2.1.7",
    "browserslist@^4.0.0": "4.28.7",
    "baseline-browser-mapping@^2.0.0": "2.11.27",
    "caniuse-lite@^1.0.0": "1.0.30001814",
    "electron-to-chromium@^1.0.0": "1.5.444",
    "node-releases@^2.0.0": "2.0.57"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@types/pdfkit": "0.17.6",
    "@typescript-eslint/parser": "8.58.2",
    "azure-functions-core-tools": "4.10.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  }
}
